# Kopiere diese Datei zu ".env" und trage echte Werte ein.
# Diese Datei (.env.example) enthält KEINE echten Secrets und darf committet werden.
# ".env" selbst steht in .gitignore und darf NIEMALS committet werden.

# --- SerpApi (Google Flights) ---
# Kostenloser Account: https://serpapi.com/users/sign_up  (250 Suchen/Monat gratis)
SERPAPI_API_KEY=

# --- Telegram ---
# Bot erstellen über @BotFather in Telegram, Token hier eintragen.
TELEGRAM_BOT_TOKEN=
# Eigene Chat-ID, z.B. über @userinfobot ermitteln.
TELEGRAM_CHAT_ID=

# --- E-Mail (SMTP) ---
# Beispiel Gmail: smtp.gmail.com, Port 587, SMTP_USER = eigene Gmail-Adresse,
# SMTP_PASSWORD = App-Passwort (NICHT das normale Gmail-Passwort!)
# App-Passwort erzeugen: https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# --- Optional ---
DB_PATH=data/flights.db
DASHBOARD_OUTPUT_PATH=docs/index.html
DAILY_COMBINATIONS_TO_CHECK=4
